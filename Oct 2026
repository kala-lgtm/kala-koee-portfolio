<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Kala Koee Portfolio</title>
<meta name="description" content="Kala Koee — 1st Assistant Director, Production Coordinator, Director. Cape Town.">
<style>
@font-face{font-family:BS;src:url(data:font/ttf;base64,);font-weight:100 900}@font-face{font-family:IS;src:url(data:font/ttf;base64,);font-weight:400 700;font-style:normal}@font-face{font-family:IS;src:url(data:font/ttf;base64,);font-weight:400 700;font-style:italic}
@page{size:1600px 900px;margin:0}
*{box-sizing:border-box;margin:0;padding:0}
:root{color-scheme:dark;--gold:#d4b26f;--gold2:#c9a564;--badge:#e8d995;--mute:#a39a88;--text:#eee7d7;--line:#4d4433;--bg:#121212;--edit:#6fa8d4}
html{font-size:clamp(7px,calc(100vw / 160),14px);scroll-behavior:smooth;background:var(--bg)}
body{font-family:IS,system-ui,sans-serif;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer}

/* ---------- nav ---------- */
.nav{position:fixed;inset:0 0 auto 0;padding-top:env(safe-area-inset-top,0px)!important;z-index:50;height:7rem;display:flex;align-items:center;justify-content:space-between;padding:0 10rem;background:linear-gradient(#121212ee,#12121200);backdrop-filter:blur(6px)}
.nav .logo{font-family:BS;font-weight:800;font-size:2.6rem;color:var(--gold);letter-spacing:.02em}
.nav .links{display:flex;gap:3.2rem}
.nav .links a{font-size:1.15rem;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--mute);transition:color .2s}
.nav .links a:hover{color:var(--gold)}

/* ---------- pages (16:9) ---------- */
.page{position:relative;width:100%;min-height:56.25vw;padding:10rem 10rem 6rem;display:flex;flex-direction:column;border-bottom:1px solid #1e1c18;background:linear-gradient(170deg,#1d1d1d 0%,#131313 55%,#0f0f0f 100%)}
.page:nth-child(even){background:linear-gradient(190deg,#1b1b1b 0%,#121212 60%,#0e0e0e 100%)}
.sh{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1px solid var(--line);padding-bottom:1.2rem;margin-bottom:3rem}
.sh h2{font-family:BS;font-weight:800;font-size:6.4rem;line-height:.88;color:var(--gold);display:flex;align-items:baseline;gap:1.6rem;text-transform:uppercase}
.sh .n{font-family:IS;font-weight:600;font-size:1.3rem;letter-spacing:.2em;color:var(--gold2)}
.sh .c{font-size:1.2rem;font-weight:600;letter-spacing:.28em;color:var(--mute);text-transform:uppercase}
.groups{display:flex;flex-direction:column;gap:3.4rem;flex:1}

/* hero */
.hero{justify-content:flex-end;overflow:hidden}
.hero .bg{position:absolute;inset:0;background:center/cover no-repeat;opacity:.38;filter:grayscale(.25)}
.hero .bg:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#121212 18%,#121212cc 45%,#12121255 75%,#12121299),linear-gradient(0deg,#121212 8%,transparent 55%)}
.hero>*:not(.bg){position:relative}
.hero .htools{position:absolute;top:9rem;right:10rem;display:none;z-index:3}
.editing .hero .htools{display:block}
.hero .htools button{background:#0e0e0ee6;border:1px solid #3a3326;color:var(--text);font-size:12px;font-weight:600;padding:6px 10px;border-radius:6px}
.hero .top{display:grid;grid-template-columns:1fr 34rem;gap:6rem;align-items:end}
.kicker{font-weight:600;font-size:1.35rem;letter-spacing:.34em;color:var(--gold2);text-transform:uppercase}
.hero h1{font-family:BS;font-weight:800;font-size:23rem;line-height:.84;color:var(--gold);margin-top:2rem;letter-spacing:-.005em}
.hero .tag{font-size:1.8rem;color:var(--mute);margin-top:2.6rem;max-width:62rem;line-height:1.45}
.index{list-style:none;border-top:1px solid var(--line)}
.index li a{display:flex;justify-content:space-between;align-items:baseline;padding:1.5rem 0;border-bottom:1px solid var(--line);font-size:1.7rem;font-weight:600;transition:color .2s,padding .2s}
.index li a span{font-size:1.1rem;letter-spacing:.2em;color:var(--gold2)}
.index li a:hover{color:var(--gold);padding-left:.8rem}
.contact{display:grid;grid-template-columns:repeat(4,auto);justify-content:space-between;border-top:2px solid var(--gold);padding-top:2.2rem;margin-top:6rem}
.contact .l{font-size:1.1rem;font-weight:600;letter-spacing:.26em;color:var(--mute);margin-bottom:.6rem}
.contact .v{font-size:1.75rem}
.contact a.v{border-bottom:1px solid var(--mute)}

/* groups */
.gh{display:flex;justify-content:space-between;align-items:baseline;gap:2rem;margin-bottom:1.6rem;padding-bottom:.9rem;border-bottom:1px dashed #3a3326}
.gh .b{font-weight:700;font-size:2.1rem}
.gh .m{font-size:1.1rem;font-weight:600;letter-spacing:.2em;color:var(--gold2);text-transform:uppercase;text-align:right}
.gh.hide{display:none}
.cards{display:grid;grid-template-columns:repeat(var(--cols,4),minmax(0,1fr));gap:2.6rem 2.2rem}
.cards.feature{grid-template-columns:1fr;gap:3rem}

/* cards */
.card{position:relative;min-width:0}
.thumb{position:relative;display:block;aspect-ratio:16/9;overflow:hidden;background:#1c1b18;border:1px solid #3a3326}
.poster .thumb{aspect-ratio:5/6}
.thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease}
a.thumb:hover img{transform:scale(1.04)}
.ph{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:1.4rem;background:linear-gradient(160deg,#25231e,#161512)}
.ph b{font-family:BS;font-weight:800;font-size:2.6rem;color:#4f4636;line-height:.95;text-transform:uppercase}
.ph i{font-style:normal;font-size:.95rem;letter-spacing:.24em;color:#5d5442;margin-top:.6rem}
.play{position:absolute;left:50%;top:50%;width:0;height:0;transform:translate(-35%,-50%);border-left:3.4rem solid var(--gold);border-top:2rem solid transparent;border-bottom:2rem solid transparent;filter:drop-shadow(0 .3rem .8rem rgba(0,0,0,.5));transition:transform .25s}
a.thumb:hover .play{transform:translate(-35%,-50%) scale(1.12)}
.badge{position:absolute;left:1rem;bottom:1rem;background:rgba(15,15,15,.82);border:1px solid #4a4130;color:var(--badge);font-size:.95rem;font-weight:600;letter-spacing:.24em;padding:.5rem .9rem}
.cols-6 .play,.cols-7 .play{border-left-width:2.4rem;border-top-width:1.4rem;border-bottom-width:1.4rem}
.t{font-weight:600;font-size:1.85rem;margin-top:1.3rem;line-height:1.2}
.t i,.t em{font-weight:700}
.r{font-size:1.05rem;font-weight:600;letter-spacing:.2em;color:var(--gold2);text-transform:uppercase;margin-top:.7rem;line-height:1.55}
.d{font-size:1.35rem;color:var(--mute);margin-top:.7rem;line-height:1.5}
.co{font-size:1.25rem;color:var(--mute);margin-top:.5rem}
.feature .card{display:grid;grid-template-columns:1.45fr 1fr;gap:4.4rem;align-items:center}
.feature .t{font-size:3.4rem;margin-top:0}
.feature .r{font-size:1.25rem;margin-top:1.2rem}
.feature .d,.feature .co{font-size:1.6rem;margin-top:1.1rem}
.cols-2 .t{font-size:2.3rem}
.view .f-empty{display:none}

.foot{margin-top:4rem;border-top:2px solid var(--gold);padding-top:2rem;display:flex;justify-content:space-between;align-items:center}
.foot .n{font-family:BS;font-weight:800;font-size:4rem;color:var(--gold)}
.foot .e{font-size:1.7rem}

/* ---------- editor ---------- */
.toolbar{position:fixed;right:2rem;bottom:2rem;z-index:60;display:flex;gap:.6rem;background:#0d0d0dee;border:1px solid #3a3326;border-radius:999px;padding:.6rem;box-shadow:0 1rem 3rem rgba(0,0,0,.5);font-size:13px}
.toolbar button{border:0;background:transparent;padding:9px 16px;border-radius:999px;font-weight:600;letter-spacing:.04em}
.toolbar button:hover{background:#262420}
.toolbar .primary{background:var(--gold);color:#141414}
.toolbar .primary:hover{background:#e2c384}
.toolbar .ed{display:none}
.editing .toolbar .ed{display:inline-block}
.banner{position:fixed;left:50%;top:8rem;transform:translateX(-50%);z-index:70;background:#2a2418;border:1px solid var(--gold2);color:var(--text);font-size:13px;padding:10px 14px;border-radius:8px;display:flex;gap:12px;align-items:center}
.banner button{background:var(--gold);color:#141414;border:0;border-radius:6px;padding:5px 10px;font-weight:600}
.toast{position:fixed;left:50%;bottom:9rem;transform:translateX(-50%);z-index:80;background:#eee7d7;color:#141414;font-size:13px;font-weight:600;padding:10px 16px;border-radius:8px;opacity:0;transition:opacity .25s;pointer-events:none;max-width:90vw;text-align:center}
.toast.on{opacity:1}

.editing [contenteditable]{outline:1px dashed transparent;outline-offset:3px;border-radius:2px;cursor:text;min-width:2ch}
.editing [contenteditable]:hover{outline-color:#6fa8d488}
.editing [contenteditable]:focus{outline:1px solid var(--edit)}
.editing [contenteditable]:empty:before{content:attr(data-ph);color:#5f5848;font-style:italic;letter-spacing:normal;text-transform:none}
.tools{position:absolute;top:.8rem;right:.8rem;display:none;gap:.4rem;z-index:3}
.editing .tools{display:flex}
.tools button,.gtools button{background:#0e0e0ee6;border:1px solid #3a3326;color:var(--text);font-size:12px;font-weight:600;padding:5px 8px;border-radius:6px;line-height:1}
.tools button:hover,.gtools button:hover{border-color:var(--edit);color:#fff}
.tools .drag,.gtools .gdrag{cursor:grab}
.tools .del:hover,.gtools .gdel:hover{border-color:#d46f6f;color:#ffb3b3}
.editing .card .thumb{cursor:pointer}
.editing .ph{border:1.5px dashed #5a4f3a}
.editing .ph:after{content:"+ Add image  ·  click or drop";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:12px;font-weight:600;color:var(--gold2);white-space:nowrap}
.nolink{position:absolute;left:1rem;bottom:1rem;font-size:11px;font-weight:600;color:#9db9cf;background:#0e0e0ee6;border:1px dashed #6fa8d4;border-radius:5px;padding:3px 7px;display:none}
.editing .nolink{display:block}
.thumb.drop{outline:2px solid var(--edit);outline-offset:-2px}
.gtools{display:none;gap:.4rem;align-items:center;flex-wrap:wrap}
.editing .gtools{display:flex}
.editing .gh.hide{display:flex;opacity:.55}
.gtools select{background:#0e0e0e;border:1px solid #3a3326;color:var(--text);font-size:12px;border-radius:6px;padding:4px}
.gtools .cn{font-size:12px;color:var(--mute);min-width:3ch;text-align:center}
.add{display:none;margin-top:1.4rem;border:1.5px dashed #5a4f3a;background:transparent;color:var(--gold2);font-size:12px;font-weight:600;letter-spacing:.06em;padding:9px 14px;border-radius:6px}
.editing .add{display:inline-block}
.add:hover{border-color:var(--edit);color:#fff}
.sortable-ghost{opacity:.35}
.sortable-chosen .thumb{outline:2px solid var(--edit)}

dialog{margin:auto;background:#181715;color:var(--text);border:1px solid #3a3326;border-radius:12px;padding:22px;width:min(440px,92vw);font-size:14px}
dialog::backdrop{background:#000a}
dialog h3{font-family:BS;font-weight:800;font-size:28px;color:var(--gold);margin-bottom:14px}
dialog label{display:block;font-size:11px;font-weight:600;letter-spacing:.18em;color:var(--mute);margin:14px 0 6px;text-transform:uppercase}
dialog input[type=url],dialog select{width:100%;background:#0e0e0e;border:1px solid #3a3326;color:var(--text);border-radius:8px;padding:10px;font:inherit}
dialog input:focus,dialog select:focus{outline:1px solid var(--edit)}
.dimg{display:flex;gap:10px;align-items:center}
.dimg .pv{width:120px;aspect-ratio:16/9;background:#0e0e0e center/cover no-repeat;border:1px solid #3a3326;border-radius:6px;flex:none}
.dimg button,.drow button{background:#262420;border:1px solid #3a3326;border-radius:8px;padding:9px 12px;font-weight:600}
.drow{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}
.drow .ok{background:var(--gold);color:#141414;border-color:var(--gold)}

/* ---------- mobile ---------- */
@media screen and (max-width:760px){
  .hero .htools{right:2rem;top:8rem}
  html{font-size:9px}
  .nav{padding:0 2rem;height:6.4rem}
  .nav .links{display:none}
  .page{min-height:auto;padding:9rem 2rem 5rem}
  .hero{min-height:100svh}
  .hero .top{grid-template-columns:1fr;gap:4rem}
  .hero h1{font-size:12rem}
  .contact{grid-template-columns:1fr 1fr;gap:2rem 1rem}
  .sh h2{font-size:4.6rem}
  .sh{flex-wrap:wrap;gap:1rem}
  .cards{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:2.4rem 1.6rem}
  .cards.cols-1,.cards.cols-2{grid-template-columns:1fr!important}
  .cards:not(.cols-1):not(.cols-2) .play{border-left-width:2.2rem;border-top-width:1.3rem;border-bottom-width:1.3rem}
  .cards:not(.cols-1):not(.cols-2) .badge{font-size:.85rem;padding:.4rem .7rem;left:.7rem;bottom:.7rem}
  .feature .card{grid-template-columns:1fr;gap:1.6rem}
  .feature .t{font-size:2.6rem}
  .gh{flex-direction:column;gap:.6rem}
  .gh .m{text-align:left}
  .toolbar{right:50%;transform:translateX(50%);bottom:1.4rem}
  .tools{display:none}
  .editing .tools{display:flex}
}

/* ---------- print / PDF: one 16:9 page per section ---------- */
@media print{
  html{font-size:10px}
  .nav,.toolbar,.banner,.toast,.tools,.gtools,.add,.nolink{display:none!important}
  .page{width:1600px;height:900px;min-height:0;overflow:hidden;break-after:page;page-break-after:always;border:0}
  .page:last-child{break-after:auto}
  .page{padding-top:7rem}
  .editing .gh.hide{display:none}
}
