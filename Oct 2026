evelopment", "groups": [{"id": "g7", "name": "", "meta": "", "layout": "poster", "cols": 4, "cards": [{"id": "c21", "title": "\u003ci>The New Dawn\u003c/i>", "r": "Series", "d": "Director & Executive Producer", "co": "M4 PICTURES", "img": "data:image/jpeg;base64,", "url": "", "kind": "none"}, {"id": "c22", "title": "\u003ci>Kagiso\u003c/i>", "r": "Series", "d": "Director & Executive Producer", "co": "M4 PICTURES", "img": "data:image/jpeg;base64,", "url": "", "kind": "none"}, {"id": "c23", "title": "\u003ci>Umsbenzi Wam'\u003c/i>", "r": "Feature", "d": "Director & Executive Producer", "co": "M4 PICTURES", "img": "data:image/jpeg;base64,", "url": "", "kind": "none"}, {"id": "c24", "title": "\u003ci>Corner Shop\u003c/i>", "r": "Microdrama", "d": "Director & Executive Producer", "co": "M4 PICTURES", "img": "data:image/jpeg;base64,", "url": "", "kind": "none"}]}], "footer": true, "countPrefix": "M4 Pictures"}]}</script>
<script>
(function(){
const SHELL='\n'+document.documentElement.outerHTML;
const KEY='kk-portfolio-draft';
let S=JSON.parse(document.getElementById('data').textContent);
let editing=false, sorts=[], draftT=null;
const $=s=>document.querySelector(s), app=$('#app');
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const uid=()=>Math.random().toString(36).slice(2,9);
const clean=h=>String(h).replace(/<(?!\/?(i|em|b|strong)\b)[^>]*>/gi,'').replace(/&nbsp;/g,' ').trim();





function persist(){clearTimeout(draftT);draftT=setTimeout(()=>{S.savedAt=Date.now();try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){toast('Too big to autosave here — press Save HTML to keep your edits')}},300)}
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('on'),3200)}
function banner(){const b=document.createElement('div');b.className='banner';b.innerHTML='Showing unsaved edits from this browser. <button>Discard</button>';b.querySelector('button').onclick=()=>{localStorage.removeItem(KEY);location.reload()};document.body.appendChild(b);setTimeout(()=>b.remove(),9000)}

const ce=(field,val,ph,html)=>{
  const v=html?(val||''):esc(val);
  if(!editing) return v;
  return v;
};
function F(tag,cls,attrs,val,ph,html){ // editable field
  const empty=!String(val||'').trim();
  if(!editing&&empty) return '';
  const inner=html?(val||''):esc(val);
  return `<${tag} class="${cls}${empty?' f-empty':''}" ${editing?`contenteditable="true" data-ph="${esc(ph)}"`:''} ${attrs}>${inner}</${tag}>`;
}
const count=p=>p.count||((p.countPrefix?p.countPrefix+' · ':'')+(n=>n+(n===1?' Project':' Projects'))(p.groups.reduce((a,g)=>a+g.cards.length,0)));

function cardHTML(c,g){
  const hasLink=!!c.url&&c.kind!=='none';
  const over=c.kind==='video'&&hasLink?'<span class="play"></span><span class="badge">WATCH</span>':c.kind==='stills'&&hasLink?'<span class="badge">VIEW</span>':'';
  const img=c.img?`<img src="${c.img}" alt="${esc(clean(c.title).replace(/<[^>]+>/g,''))}">`:`<div class="ph"><b>${clean(c.title).replace(/<[^>]+>/g,'')}</b><i>IMAGE TO COME</i></div>`;
  const thumb=(!editing&&hasLink)?`<a class="thumb" href="${esc(c.url)}" target="_blank" rel="noopener">${img}${over}</a>`
    :`<div class="thumb" data-act="media">${img}${over}${editing&&!hasLink&&c.kind!=='none'?'<span class="nolink">+ add link</span>':''}</div>`;
  const P=`data-c="${c.id}"`;
  return `<div class="card" data-id="${c.id}">
    <div class="tools"><button class="drag" title="Drag to move">⠿</button><button data-act="media">Image / Link</button><button data-act="dup" title="Duplicate">⧉</button><button class="del" data-act="del" title="Delete">✕</button></div>
    ${thumb}
    <div class="txt">${F('div','t',P+' data-f="title"',c.title,'Project title',true)}${F('div','r',P+' data-f="r"',c.r,'Role · Year')}${F('div','d',P+' data-f="d"',c.d,'Description')}${F('div','co',P+' data-f="co"',c.co,'Company')}</div>
  </div>`;
}
function groupHTML(g){
  const hidden=!(g.name||'').trim()&&!(g.meta||'').trim();
  const cls=g.layout==='feature'?'feature':g.layout==='poster'?'poster':'';
  const G=`data-g="${g.id}"`;
  return `<div class="grp" data-gid="${g.id}">
    <div class="gh${hidden?' hide':''}">${F('span','b',G+' data-f="name"',g.name,'Group name (optional)')||'<span></span>'}
      <span style="display:flex;gap:1.4rem;align-items:baseline">${F('span','m',G+' data-f="meta"',g.meta,'Role · Year · Company')}
      <span class="gtools"><button class="gdrag" title="Drag group">⠿</button>
        <select data-gact="layout" title="Layout"><option value="grid"${g.layout==='grid'?' selected':''}>16:9 grid</option><option value="poster"${g.layout==='poster'?' selected':''}>Posters</option><option value="feature"${g.layout==='feature'?' selected':''}>Feature</option></select>
        <button data-gact="cm" title="Fewer columns">−</button><span class="cn">${g.cols} col</span><button data-gact="cp" title="More columns">+</button>
        <button class="gdel" data-gact="gdel" title="Delete group">✕</button></span></span>
    </div>
    <div class="cards ${cls} cols-${g.cols}" style="--cols:${g.layout==='feature'?1:g.cols}" data-gid="${g.id}">${g.cards.map(c=>cardHTML(c,g)).join('')}</div>
    <button class="add" data-gact="addc">+ Add project</button>
  </div>`;
}
function heroHTML(p){
  const pr=S.profile, X=f=>`data-pr="${f}"`;
  const navPages=S.pages.filter(q=>q.nav);
  const link=(href,val,f)=>editing?F('div','v',X(f),val,f):`<a class="v" href="${href}" ${href.startsWith('http')?'target="_blank" rel="noopener"':''}>${esc(val)}</a>`;
  return `<section class="page hero" id="${p.id}"><div class="bg" style="${pr.heroImg?`background-image:url(${pr.heroImg})`:''}"></div><div class="htools"><button data-hact="hero">Background image…</button></div>
    <div class="top"><div>${F('div','kicker',X('kicker'),pr.kicker,'Title line')}${F('h1','',X('name'),pr.name,'Name')}${F('div','tag',X('tag'),pr.tag,'Optional one-line intro')}</div>
      <ul class="index">${navPages.map(q=>`<li><a href="#${q.id}"><b>${esc(q.title)}</b><span>${esc(q.num||'')}</span></a></li>`).join('')}</ul></div>
    <div class="contact">
      <div><div class="l">PHONE</div>${link('tel:'+pr.phone.replace(/\s/g,''),pr.phone,'phone')}</div>
      <div><div class="l">EMAIL</div>${link('mailto:'+pr.email,pr.email,'email')}</div>
      <div><div class="l">BASED IN</div>${F('div','v',X('location'),pr.location,'location')}</div>
      <div><div class="l">PORTFOLIO</div>${link('https://'+pr.portfolio.replace(/^https?:\/\//,''),pr.portfolio,'portfolio')}</div>
    </div></section>`;
}
function pageHTML(p){
  if(p.type==='hero') return heroHTML(p);
  const P=`data-p="${p.id}"`;
  return `<section class="page" id="${p.id}">
    <div class="sh"><h2>${F('span','n',P+' data-f="num"',p.num,'00')}${F('span','',P+' data-f="title"',p.title,'Section title')}</h2><div class="c">${esc(count(p))}</div></div>
    <div class="groups" data-pid="${p.id}">${p.groups.map(groupHTML).join('')}</div>
    <button class="add" data-pact="addg" data-pid="${p.id}" style="align-self:flex-start">+ Add group</button>
    ${p.footer?`<div class="foot"><span class="n">${esc(S.profile.name)}</span><a class="e" href="mailto:${esc(S.profile.email)}">${esc(S.profile.email)}</a></div>`:''}
  </section>`;
}
function render(){
  sorts.forEach(s=>s.destroy());sorts=[];
  const y=scrollY;
  document.body.classList.toggle('editing',editing);
  document.body.classList.toggle('view',!editing);
  const nav=`<nav class="nav"><a class="logo" href="#hero">${esc(S.profile.name)}</a><div class="links">${S.pages.filter(p=>p.nav).map(p=>`<a href="#${p.id}">${esc(p.nav)}</a>`).join('')}<a href="mailto:${esc(S.profile.email)}">Contact</a></div></nav>`;
  app.innerHTML=nav+S.pages.map(pageHTML).join('');
  document.documentElement.style.scrollBehavior='auto';scrollTo(0,y);document.documentElement.style.scrollBehavior='';
  if(editing&&window.Sortable){
    document.querySelectorAll('.cards').forEach(el=>sorts.push(Sortable.create(el,{group:'cards',handle:'.drag',animation:180,onEnd:sync})));
    document.querySelectorAll('.groups').forEach(el=>sorts.push(Sortable.create(el,{group:'groups',handle:'.gdrag',animation:180,draggable:'.grp',onEnd:sync})));
  }
}
function maps(){const C={},G={};S.pages.forEach(p=>(p.groups||[]).forEach(g=>{G[g.id]=g;g.cards.forEach(c=>C[c.id]=c)}));return{C,G}}
function sync(){
  const {C,G}=maps();
  S.pages.forEach(p=>{const el=document.querySelector(`.groups[data-pid="${p.id}"]`);if(el)p.groups=[...el.children].filter(x=>x.dataset.gid).map(x=>G[x.dataset.gid])});
  S.pages.forEach(p=>(p.groups||[]).forEach(g=>{const el=document.querySelector(`.cards[data-gid="${g.id}"]`);if(el)g.cards=[...el.children].filter(x=>x.dataset.id).map(x=>C[x.dataset.id])}));
  persist();render();
}
const findCard=id=>maps().C[id], findGroup=id=>maps().G[id];
const groupOfCard=id=>{for(const p of S.pages)for(const g of p.groups||[])if(g.cards.some(c=>c.id===id))return g};

// text edits
app.addEventListener('input',e=>{
  const el=e.target.closest('[contenteditable]');if(!el)return;
  const f=el.dataset.f, v=f==='title'?clean(el.innerHTML):el.textContent.trim();
  if(el.dataset.c)findCard(el.dataset.c)[f]=v;
  else if(el.dataset.g)findGroup(el.dataset.g)[f]=v;
  else if(el.dataset.p)S.pages.find(p=>p.id===el.dataset.p)[f]=v;
  else if(el.dataset.pr)S.profile[el.dataset.pr]=v;
  el.classList.toggle('f-empty',!v);
  persist();
});
app.addEventListener('focusout',e=>{if(e.target.closest('[contenteditable]'))render()});
app.addEventListener('paste',e=>{if(e.target.closest('[contenteditable]')){e.preventDefault();document.execCommand('insertText',false,(e.clipboardData||window.clipboardData).getData('text'))}});
app.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.closest('[contenteditable]')){e.preventDefault();e.target.blur()}});

// clicks
app.addEventListener('click',e=>{
  if(!editing)return;
  const a=e.target.closest('[data-act]'), ga=e.target.closest('[data-gact]'), pa=e.target.closest('[data-pact]');
  if(a){const id=a.closest('.card').dataset.id, g=groupOfCard(id), c=findCard(id);
    if(a.dataset.act==='media')openMedia(c);
    if(a.dataset.act==='del'&&confirm('Delete this project?')){g.cards=g.cards.filter(x=>x.id!==id);persist();render()}
    if(a.dataset.act==='dup'){const i=g.cards.indexOf(c);g.cards.splice(i+1,0,{...c,id:uid()});persist();render()}
  }
  if(ga&&ga.tagName==='BUTTON'){const g=findGroup(ga.closest('.grp').dataset.gid);
    if(ga.dataset.gact==='cp')g.cols=Math.min(7,g.cols+1);
    if(ga.dataset.gact==='cm')g.cols=Math.max(1,g.cols-1);
    if(ga.dataset.gact==='addc'){g.cards.push({id:uid(),title:'New project',r:'Video · 2026',d:'',co:'',img:'',url:'',kind:'video'})}
    if(ga.dataset.gact==='gdel'){if(!confirm('Delete this group and its '+g.cards.length+' projects?'))return;S.pages.forEach(p=>p.groups&&(p.groups=p.groups.filter(x=>x!==g)))}
    persist();render();
  }
  if(e.target.closest('[data-hact]')){const f=$('#file');f.value='';f.onchange=()=>f.files[0]&&readImg(f.files[0]).then(d=>{S.profile.heroImg=d;persist();render()});if(S.profile.heroImg&&confirm('Remove the current background image? (Cancel = choose a new one)')){S.profile.heroImg='';persist();render();return}f.click()}
  if(pa){const p=S.pages.find(q=>q.id===pa.dataset.pid);p.groups.push({id:uid(),name:'New group',meta:'',layout:'grid',cols:4,cards:[]});persist();render()}
});
app.addEventListener('change',e=>{const s=e.target.closest('[data-gact="layout"]');if(!s)return;const g=findGroup(s.closest('.grp').dataset.gid);g.layout=s.value;if(s.value==='feature')g.cols=1;else if(g.cols<2)g.cols=4;persist();render()});

// drop an image file straight onto a thumbnail
app.addEventListener('dragover',e=>{const t=e.target.closest('.thumb');if(editing&&t&&e.dataTransfer.types.includes('Files')){e.preventDefault();t.classList.add('drop')}});
app.addEventListener('dragleave',e=>{const t=e.target.closest('.thumb');t&&t.classList.remove('drop')});
app.addEventListener('drop',e=>{const t=e.target.closest('.thumb');if(!editing||!t||!e.dataTransfer.files.length)return;e.preventDefault();const c=findCard(t.closest('.card').dataset.id);readImg(e.dataTransfer.files[0]).then(d=>{c.img=d;persist();render()})});

function readImg(file){return new Promise(res=>{const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const max=1600,s=Math.min(1,max/im.width),cv=document.createElement('canvas');cv.width=Math.round(im.width*s);cv.height=Math.round(im.height*s);cv.getContext('2d').drawImage(im,0,0,cv.width,cv.height);res(cv.toDataURL('image/jpeg',.85))};im.src=r.result};r.readAsDataURL(file)})}

render();
})();
</script>

</body></html>
